<idea-plugin>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="FlappyBoards"
                    anchor="right"
                    factoryClass="dev.flappyboards.FlappyBoardsToolWindowFactory"
                    icon="/icons/flappyboards.svg"
                    canCloseContents="false"/>
        <applicationConfigurable parentId="tools"
                                 id="dev.flappyboards.settings"
                                 instance="dev.flappyboards.settings.FlappyBoardsConfigurable"
                                 displayName="FlappyBoards"/>
    </extensions>

    <actions>
        <action id="dev.flappyboards.OpenGame"
                class="dev.flappyboards.OpenFlappyBoardsAction"
                text="Open FlappyBoards"
                description="Open the FlappyBoards game tool window"
                icon="/icons/flappyboards.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt F"/>
        </action>
    </actions>
</idea-plugin>
